{
  "name": "bun-react-htmx",
  "module": "src/index.ts",
  "type": "module",
  "scripts": {
    "dev": "bun run --hot src/index.ts & bun run dev:tw",
    "dev:build": "bun run src/index.ts",
    "dev:tw": "bun run build:tw -- --watch",
    "start": "./build/app.bun",
    "build": "bun --compile --bytecode build --minify ./src/index.ts --outfile build/app.bun",
    "build:tw": "tailwindcss -i ./src/main.css -o ./public/main.css",
    "deploy": "fly deploy"
  },
  "dependencies": {
    "@tailwindcss/cli": "^4.1.5",
    "tailwindcss": "^4.1.5",
    "clsx": "^2.1.1",
    "daisyui": "^5.0.35",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "bun-types": "latest",
    "@types/react-dom": "^19.1.3",
    "typescript": "^5.8.3"
  }
}
